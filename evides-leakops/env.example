# Copy to ".env" (git-ignored) or put the values in each Functions app's local.settings.json.
# Names follow .github/copilot-instructions.md; the last block is specific to LeakOps.

AZURE_AI_PROJECT_ENDPOINT=
MODEL_DEPLOYMENT_NAME=gpt-5.4
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE_NAME=LeakOpsDB

# LeakOps
MCP_SERVER_URL=http://localhost:7071/runtime/webhooks/mcp
MCP_AUTH_KEY=
AGENTS_BASE_URL=http://localhost:7072/api
WATERSTORING_BASE_URL=http://localhost:5080
WATERSTORING_API_KEY=dev-waterstoring-key
