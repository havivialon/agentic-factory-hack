// Evides LeakOps demo in its own resource group. Everything the demo needs is created here, so it is fully separate from the
// tire-factory demo:
//   - Microsoft Foundry (resource, project, gpt-5.4 deployment, Application Insights for tracing, and the MCP connection the agents use)
//   - Cosmos DB (serverless), storage account, Log Analytics and Application Insights
//   - two Flex Consumption function apps (MCP tools, agent runner) and a Basic App Service plan with two web apps
//     (the fake Waterstoring.nl and the workflow host with its operator console)
//   - the access rights between them (managed identities, no keys except the ones the services themselves require)
// Deploy with deploy/deploy.ps1, which creates the resource group, publishes the code and sets the keys that only exist after the first deployment.

targetScope = 'resourceGroup'

@description('Short unique suffix for globally unique names (deploy.ps1 derives it from the subscription and resource group).')
@minLength(4)
@maxLength(8)
param suffix string
param location string = resourceGroup().location
@description('Region of the web plan and the two web apps. Basic plans can be out of capacity in Sweden Central, so this can differ from the rest.')
param webLocation string = location
@description('Name of the model deployment the agents use.')
param modelDeploymentName string = 'gpt-5.4'
param modelName string = 'gpt-5.4'
param modelVersion string = '2026-03-05'
@description('Global Standard capacity in thousands of tokens per minute. Pay per token, no fixed cost.')
param modelCapacity int = 150
@description('B1 is about 11.80 EUR a month and keeps the apps loaded. F1 is free but sleeps when idle.')
@allowed([ 'B1', 'F1' ])
param webSku string = 'B1'
@description('Object id of the person who deploys and demos. Gets the Foundry User role so the agents can be created and tried in the portal.')
param deployerPrincipalId string = ''
@description('Key the agents need to publish to the fake Waterstoring site. Generated by deploy.ps1.')
@secure()
param waterstoringApiKey string
@description('Key the operator types in the console to start workflows. Generated by deploy.ps1.')
@secure()
param operatorKey string
@description('System key (mcp_extension) of the MCP function app. Foundry sends it with every tool call. Generated by deploy.ps1.')
@secure()
param mcpKey string
@description('Function key of the agents app, which the workflow host sends with every agent call. Generated by deploy.ps1.')
@secure()
param agentsKey string

var tags = { project: 'evides-leakops', demo: 'evides-ai-foundry' }
var cosmosName = 'evides-cosmos-${suffix}'
var storageName = 'evidessa${suffix}'
var foundryName = 'evides-foundry-${suffix}'
var projectName = 'evides-leakops'
var projectEndpoint = 'https://${foundryName}.services.ai.azure.com/api/projects/${projectName}'
var appInsightsName = 'evides-appinsights-${suffix}'
var logAnalyticsName = 'evides-logs-${suffix}'

// Built-in role "Foundry User" (also called Azure AI User): lets an identity use the agents and models of the Foundry resource.
var foundryUserRoleId = '53ca6127-db72-4b80-b1b0-d745d6d5456d'
// Built-in Cosmos DB data role "Cosmos DB Built-in Data Contributor" (a data-plane role, separate from Azure RBAC).
var cosmosDataContributorRoleId = '00000000-0000-0000-0000-000000000002'

// ---- Monitoring --------------------------------------------------------------------------------------------------

resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: logAnalyticsName
  location: location
  tags: tags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

resource appInsights 'Microsoft.Insights/components@2020-02-02' = {
  name: appInsightsName
  location: location
  tags: tags
  kind: 'web'
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: logs.id
  }
}

// ---- Data --------------------------------------------------------------------------------------------------------

resource cosmos 'Microsoft.DocumentDB/databaseAccounts@2024-05-15' = {
  name: cosmosName
  location: location
  tags: tags
  kind: 'GlobalDocumentDB'
  properties: {
    databaseAccountOfferType: 'Standard'
    capabilities: [ { name: 'EnableServerless' } ]
    consistencyPolicy: { defaultConsistencyLevel: 'Session' }
    locations: [ { locationName: location, failoverPriority: 0, isZoneRedundant: false } ]
  }
}

resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: storageName
  location: location
  tags: tags
  kind: 'StorageV2'
  sku: { name: 'Standard_LRS' }
  properties: {
    minimumTlsVersion: 'TLS1_2'
    allowBlobPublicAccess: false
    allowSharedKeyAccess: false
    supportsHttpsTrafficOnly: true
  }
}

resource blobService 'Microsoft.Storage/storageAccounts/blobServices@2023-05-01' = {
  parent: storage
  name: 'default'
}

// ---- Microsoft Foundry -------------------------------------------------------------------------------------------

resource foundry 'Microsoft.CognitiveServices/accounts@2025-06-01' = {
  name: foundryName
  location: location
  tags: tags
  kind: 'AIServices'
  sku: { name: 'S0' }
  identity: { type: 'SystemAssigned' }
  properties: {
    customSubDomainName: foundryName
    allowProjectManagement: true
    publicNetworkAccess: 'Enabled'
    disableLocalAuth: true
  }
}

resource foundryProject 'Microsoft.CognitiveServices/accounts/projects@2025-06-01' = {
  parent: foundry
  name: projectName
  location: location
  tags: tags
  identity: { type: 'SystemAssigned' }
  properties: {
    displayName: 'Evides LeakOps'
    description: 'Six cooperating agents that handle a drinking-water leak, from alarm to resident notice (simulated data).'
  }
}

resource model 'Microsoft.CognitiveServices/accounts/deployments@2025-06-01' = {
  parent: foundry
  name: modelDeploymentName
  sku: {
    name: 'GlobalStandard'
    capacity: modelCapacity
  }
  properties: {
    model: {
      format: 'OpenAI'
      name: modelName
      version: modelVersion
    }
  }
}

// Connecting Application Insights to the project switches on tracing: every agent run shows up under Tracing in the portal.
resource tracingConnection 'Microsoft.CognitiveServices/accounts/projects/connections@2025-06-01' = {
  parent: foundryProject
  name: 'evides-appinsights'
  properties: {
    category: 'AppInsights'
    authType: 'ApiKey'
    target: appInsights.id
    isSharedToAll: false
    credentials: { key: appInsights.properties.ConnectionString }
    metadata: {
      ApiType: 'Azure'
      ResourceId: appInsights.id
    }
  }
}

// The tools of the agents live in the MCP function app. Foundry calls it with this connection, which holds the key,
// so the key is never part of an agent definition.
resource mcpConnection 'Microsoft.CognitiveServices/accounts/projects/connections@2025-06-01' = {
  parent: foundryProject
  name: 'leakops-mcp'
  properties: {
    category: 'RemoteTool'
    authType: 'CustomKeys'
    target: 'https://${mcp.outputs.hostName}/runtime/webhooks/mcp'
    isSharedToAll: false
    credentials: { keys: { 'x-functions-key': mcpKey } }
    metadata: { type: 'custom_MCP' }
  }
}

// ---- Function apps -----------------------------------------------------------------------------------------------

module mcp 'functionapp.bicep' = {
  name: 'leakops-mcp'
  dependsOn: [ blobService ]
  params: {
    name: 'leakops-mcp-${suffix}'
    location: location
    tags: tags
    storageAccountName: storage.name
    appInsightsConnectionString: appInsights.properties.ConnectionString
    settings: [
      { name: 'COSMOS_ENDPOINT', value: cosmos.properties.documentEndpoint }
      { name: 'COSMOS_DATABASE_NAME', value: 'LeakOpsDB' }
    ]
  }
}

module agents 'functionapp.bicep' = {
  name: 'leakops-agents'
  dependsOn: [ blobService ]
  params: {
    name: 'leakops-agents-${suffix}'
    location: location
    tags: tags
    storageAccountName: storage.name
    appInsightsConnectionString: appInsights.properties.ConnectionString
    settings: [
      { name: 'AZURE_AI_PROJECT_ENDPOINT', value: projectEndpoint }
      { name: 'MODEL_DEPLOYMENT_NAME', value: modelDeploymentName }
      { name: 'MCP_SERVER_URL', value: 'https://${mcp.outputs.hostName}/runtime/webhooks/mcp' }
      { name: 'MCP_AUTH_KEY', value: mcpKey }
      { name: 'WATERSTORING_BASE_URL', value: 'https://${waterstoring.outputs.hostName}' }
      { name: 'WATERSTORING_API_KEY', value: waterstoringApiKey }
    ]
  }
}

// ---- Web apps ----------------------------------------------------------------------------------------------------

resource webPlan 'Microsoft.Web/serverfarms@2024-04-01' = {
  name: 'leakops-web-plan-${suffix}'
  location: webLocation
  tags: tags
  kind: 'linux'
  sku: {
    name: webSku
    tier: webSku == 'B1' ? 'Basic' : 'Free'
  }
  properties: {
    reserved: true
  }
}

module waterstoring 'webapp.bicep' = {
  name: 'leakops-waterstoring'
  params: {
    name: 'leakops-waterstoring-${suffix}'
    location: webLocation
    tags: tags
    planId: webPlan.id
    appInsightsConnectionString: appInsights.properties.ConnectionString
    alwaysOn: webSku == 'B1'
    settings: [
      { name: 'WATERSTORING_API_KEY', value: waterstoringApiKey }
      { name: 'WATERSTORING_STORE', value: 'cosmos' }
      { name: 'COSMOS_ENDPOINT', value: cosmos.properties.documentEndpoint }
      { name: 'COSMOS_DATABASE_NAME', value: 'LeakOpsDB' }
    ]
  }
}

module workflow 'webapp.bicep' = {
  name: 'leakops-workflow'
  params: {
    name: 'leakops-workflow-${suffix}'
    location: webLocation
    tags: tags
    planId: webPlan.id
    appInsightsConnectionString: appInsights.properties.ConnectionString
    alwaysOn: webSku == 'B1'
    settings: [
      { name: 'OPERATOR_KEY', value: operatorKey }
      { name: 'AGENTS_BASE_URL', value: 'https://${agents.outputs.hostName}' }
      { name: 'AGENTS_FUNCTION_KEY', value: agentsKey }
      { name: 'WATERSTORING_PUBLIC_URL', value: 'https://${waterstoring.outputs.hostName}/evides' }
    ]
  }
}

// ---- Access rights (managed identities) ----------------------------------------------------------------------------

resource mcpCosmosAccess 'Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments@2024-05-15' = {
  parent: cosmos
  name: guid(cosmos.id, 'leakops-mcp', cosmosDataContributorRoleId)
  properties: {
    roleDefinitionId: '${cosmos.id}/sqlRoleDefinitions/${cosmosDataContributorRoleId}'
    principalId: mcp.outputs.principalId
    scope: cosmos.id
  }
}

resource waterstoringCosmosAccess 'Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments@2024-05-15' = {
  parent: cosmos
  name: guid(cosmos.id, 'leakops-waterstoring', cosmosDataContributorRoleId)
  properties: {
    roleDefinitionId: '${cosmos.id}/sqlRoleDefinitions/${cosmosDataContributorRoleId}'
    principalId: waterstoring.outputs.principalId
    scope: cosmos.id
  }
}

resource agentsFoundryAccess 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: foundry
  name: guid(foundry.id, 'leakops-agents', foundryUserRoleId)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', foundryUserRoleId)
    principalId: agents.outputs.principalId
    principalType: 'ServicePrincipal'
  }
}

resource deployerFoundryAccess 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (!empty(deployerPrincipalId)) {
  scope: foundry
  name: guid(foundry.id, deployerPrincipalId, foundryUserRoleId)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', foundryUserRoleId)
    principalId: deployerPrincipalId
    principalType: 'User'
  }
}

output suffix string = suffix
output cosmosAccount string = cosmos.name
output cosmosEndpoint string = cosmos.properties.documentEndpoint
output storageAccount string = storage.name
output foundryAccount string = foundry.name
output foundryProjectEndpoint string = projectEndpoint
output modelDeployment string = modelDeploymentName
output mcpApp string = mcp.outputs.name
output agentsApp string = agents.outputs.name
output waterstoringApp string = waterstoring.outputs.name
output workflowApp string = workflow.outputs.name
output mcpUrl string = 'https://${mcp.outputs.hostName}'
output agentsUrl string = 'https://${agents.outputs.hostName}'
output waterstoringUrl string = 'https://${waterstoring.outputs.hostName}'
output workflowUrl string = 'https://${workflow.outputs.hostName}'
